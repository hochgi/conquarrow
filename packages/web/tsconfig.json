{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "docs/*": ["../../docs/*"]
    },
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "test/**/*.ts", "vite.config.ts", "vite.byok-proxy.ts"],
  "references": [
    { "path": "../contracts" },
    { "path": "../geometry-fixtures" },
    { "path": "../geometry-tiling" },
    { "path": "../rules-core" }
  ]
}
