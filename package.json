{
  "name": "conquarrow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && pnpm --filter @conquarrow/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "crap": "vitest run --coverage && node scripts/crap-report.cjs",
    "bots": "node scripts/bots-report.mjs",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:mutation:report": "node scripts/format-stryker-report.cjs",
    "dev:web": "pnpm --filter @conquarrow/web dev",
    "byok-turn": "node tools/byok-turn-runner/src/server.mjs",
    "byok-turn:test": "node --test tools/byok-turn-runner/test/*.test.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@vitest/coverage-istanbul": "^2.1.9",
    "eslint": "^9.17.0",
    "lefthook": "^2.1.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
