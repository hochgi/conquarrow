{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "ignorePatterns": [
    ".claude",
    ".agents"
  ],
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "vitest": {
    "configFile": "vitest.online-api.config.mjs"
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 30000,
  "timeoutFactor": 1.5,
  "concurrency": 4,
  "incremental": false,
  "incrementalFile": ".stryker-tmp/incremental-online-api.json",
  "disableTypeChecks": "{packages,vitest.config.ts}/**/*.{ts,tsx}",
  "mutate": [
    "packages/online-api/src/**/*.ts"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "htmlReporter": {
    "fileName": "reports/mutation-online-api/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-online-api/mutation.json"
  }
}
